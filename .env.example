# Copiez ce fichier en .env.local pour changer la configuration locale.

# Source des données :
#   mock = fake data dans le navigateur (par défaut, aucun backend nécessaire)
#   api  = backend Node.js (voir le projet backend de l’établissement)
VITE_DATA_SOURCE=mock

# URL de l'API (mode api). '/api' = même domaine que le site (proxy Vite en développement,
# ou backend qui sert aussi le site). Sinon URL absolue : https://api.mon-ecole.tg/api
VITE_API_URL=/api

# Délai simulé des fake data en millisecondes (0 = instantané).
VITE_MOCK_LATENCY=250
