    "typescript": "~5.9.3",
    "vite": "7.3.7",
    "vue-tsc": "3.2.5"
  },
  "description": "Site vitrine d'établissement scolaire (Vue 3) — fonctionne seul avec des fake data, ou connecté à l'API Node.js"
